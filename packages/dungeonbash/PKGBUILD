pkgname=dungeonbash
pkgver=1.8.2
pkgrel=1
pkgdesc="Squished Dungeon Bash: a simple roguelike game"
url="https://github.com/Jonson26/squished-dungeonbash"
license=BSD-2-Clause
arch=jolt
source=("https://github.com/Jonson26/squished-dungeonbash/archive/refs/tags/$pkgver.tar.gz")
sha256sums=(8364494117801114feb3896ef890f723ce69d92bf4c4080142731d08cf65ee58)

build() {
    cd "squished-dungeonbash-$pkgver"
    make > make.log
}

package() {
    mkdir -p "$pkgdir/usr/bin" "$pkgdir/usr/share/dungeonbash"
    cp "squished-dungeonbash-$pkgver/dungeonbash" "$pkgdir/usr/bin/"
    cp -ar "squished-dungeonbash-$pkgver/spoilers" "$pkgdir/usr/share/dungeonbash/"
}
