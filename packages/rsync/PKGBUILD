pkgname=rsync
pkgver=3.5.1
pkgrel=1
pkgdesc="Fast incremental file transfer, locally or over ssh"
url="https://rsync.samba.org/"
license=GPL-3.0-or-later
arch=jolt
source=("https://download.samba.org/pub/rsync/src/rsync-$pkgver.tar.gz")
sha256sums=(c55f9c9dc10fb8bec397b399a0fdded53cc9a2d8e30891bb0d63724d25c37bef)

build() {
    cd "rsync-$pkgver"
    CFLAGS=-Os ./configure --host=arm-linux --prefix=/usr --disable-md2man --disable-xxhash --disable-zstd --disable-lz4 \
        --disable-openssl --disable-iconv --disable-idn --disable-acl-support --disable-xattr-support --disable-ipv6 \
        --with-included-popt --with-included-zlib --with-rsh=ssh > configure.log
    make -j"$jobs" rsync > make.log
}

package() {
    mkdir -p "$pkgdir/usr/bin"
    cp "rsync-$pkgver/rsync" "$pkgdir/usr/bin/"
}
