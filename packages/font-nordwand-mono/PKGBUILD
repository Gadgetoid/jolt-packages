pkgname=font-nordwand-mono
pkgver=1.3.1
pkgrel=1
pkgdesc="Nordwand Mono TrueType font, regular and bold: jolt face NordwandMono"
url="https://github.com/tywr/Nordwand-Mono"
license=OFL-1.1
arch=any
source=("NordwandMono-TTF-$pkgver.zip::https://github.com/tywr/Nordwand-Mono/releases/download/$pkgver/NordwandMono-TTF.zip"
        "LICENSE-NordwandMono-$pkgver::https://raw.githubusercontent.com/tywr/Nordwand-Mono/$pkgver/LICENSE-FONT.txt")
sha256sums=(9725cfd15e21dede25c64c80aab54dcc3f27c4a127d20f13478c121aee5ae6c5
            e0e493edae714ad5bb243a346f3fd45ecdd94a00584118297f2d05e0f6187d38)

build() {
    unzip -o "NordwandMono-TTF-$pkgver.zip" NordwandMono-Regular.ttf NordwandMono-Bold.ttf
}

package() {
    mkdir -p "$pkgdir/usr/share/fonts"
    cp NordwandMono-Regular.ttf NordwandMono-Bold.ttf "$pkgdir/usr/share/fonts/"
    cp "LICENSE-NordwandMono-$pkgver" "$pkgdir/usr/share/fonts/LICENSE-NordwandMono"
}
